{
  "name": "getclosr-dev",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [{ "pattern": "getclosr.link", "custom_domain": true }],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/fk/*"]
  },
  "observability": { "enabled": false }
}
